<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="795.0" prefWidth="1302.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nasar.mustafa.warehub.controllers.SalesReportsController">
    <center>
        <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="747.0" prefWidth="1302.0" spacing="10.0">
            <children>
                <Label alignment="CENTER" text="تقارير المبيعات" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" spacing="10.0">
                    <children>
                        <Label text="من تاريخ" />
                        <DatePicker fx:id="fromDatePicker" nodeOrientation="RIGHT_TO_LEFT" />
                        <Label text="إلى تاريخ" />
                        <DatePicker fx:id="toDatePicker" nodeOrientation="RIGHT_TO_LEFT" />
                        <Label text="العميل" />
                        <ComboBox fx:id="customerComboBox" prefWidth="200.0" />
                        <Label text="الصنف" />
                        <ComboBox fx:id="itemComboBox" prefWidth="200.0" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
                <TableView fx:id="salesTable" nodeOrientation="RIGHT_TO_LEFT" prefHeight="587.0" prefWidth="1282.0">
                    <columns>
                        <TableColumn fx:id="dateColumn" prefWidth="100.0" text="التاريخ" />
                        <TableColumn fx:id="invoiceNumberColumn" prefWidth="100.0" text="رقم الفاتورة" />
                        <TableColumn fx:id="customerColumn" prefWidth="150.0" text="العميل" />
                        <TableColumn fx:id="itemColumn" prefWidth="150.0" text="الصنف" />
                        <TableColumn fx:id="quantityColumn" prefWidth="80.0" text="الكمية" />
                        <TableColumn fx:id="priceColumn" prefWidth="100.0" text="السعر" />
                        <TableColumn fx:id="totalColumn" prefWidth="120.0" text="الإجمالي" />
                    </columns>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </TableView>
                <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" prefHeight="20.0" prefWidth="1046.0" spacing="10.0">
                    <children>
                        <Label contentDisplay="TOP" nodeOrientation="RIGHT_TO_LEFT" text="إجمالي المبيعات" textAlignment="RIGHT" />
                        <Label fx:id="totalSalesLabel" text="0.0">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Button fx:id="printReportButton" mnemonicParsing="false" onAction="#onGenerateReport" text="تجميع التقرير" />
                        <Button fx:id="exportButton" mnemonicParsing="false" onAction="#onExportReport" text="تصدير كملف PDF" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
