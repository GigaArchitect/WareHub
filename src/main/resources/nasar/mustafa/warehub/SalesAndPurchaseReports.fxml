<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nasar.mustafa.warehub.controllers.SalesAndPurchaseReportsController">
   <center>
      <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0">
         <children>
            <Label alignment="CENTER" text="تقارير البيع والشراء" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" spacing="10.0">
               <children>
                  <Label text="من تاريخ:" />
                  <DatePicker fx:id="fromDatePicker" />
                  <Label text="إلى تاريخ:" />
                  <DatePicker fx:id="toDatePicker" />
                  <Label text="نوع التقرير:" />
                  <ComboBox fx:id="reportTypeComboBox" prefWidth="150.0" />
                  <Button fx:id="generateReportButton" mnemonicParsing="false" onAction="#onGenerateReport" text="إنشاء التقرير" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
            <TabPane nodeOrientation="RIGHT_TO_LEFT" tabClosingPolicy="UNAVAILABLE">
              <tabs>
                <Tab text="جدول البيانات">
                     <content>
                        <TableView fx:id="reportTable" nodeOrientation="RIGHT_TO_LEFT">
                           <columns>
                              <TableColumn fx:id="dateColumn" prefWidth="100.0" text="التاريخ" />
                              <TableColumn fx:id="salesColumn" prefWidth="120.0" text="المبيعات" />
                              <TableColumn fx:id="purchasesColumn" prefWidth="120.0" text="المشتريات" />
                              <TableColumn fx:id="profitColumn" prefWidth="120.0" text="الربح" />
                           </columns>
                        </TableView>
                     </content>
                </Tab>
                <Tab text="الرسم البياني">
                     <content>
                        <BarChart fx:id="reportChart" animated="false" title="مقارنة المبيعات والمشتريات">
                          <xAxis>
                            <CategoryAxis side="BOTTOM" label="الفترة الزمنية" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis side="LEFT" label="المبلغ" />
                          </yAxis>
                        </BarChart>
                     </content>
                </Tab>
              </tabs>
            </TabPane>
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="20.0">
               <children>
                  <Label text="إجمالي المبيعات:">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="totalSalesLabel" text="0.0">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label text="إجمالي المشتريات:">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="totalPurchasesLabel" text="0.0">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label text="صافي الربح:">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="netProfitLabel" text="0.0">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="printReportButton" mnemonicParsing="false" onAction="#onPrintReport" text="طباعة التقرير" />
                  <Button fx:id="exportButton" mnemonicParsing="false" onAction="#onExportToExcel" text="تصدير إلى Excel" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
