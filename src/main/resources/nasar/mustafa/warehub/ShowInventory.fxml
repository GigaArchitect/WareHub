ory.fxml -->
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nasar.mustafa.warehub.controllers.ShowInventoryController">
   <center>
      <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0">
         <children>
            <Label alignment="CENTER" text="عرض البضاعة" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" spacing="10.0">
               <children>
                  <Label text="البحث:" />
                  <TextField fx:id="searchField" prefWidth="200.0" promptText="اسم الصنف أو الكود" />
                  <Label text="التصنيف:" />
                  <ComboBox fx:id="categoryComboBox" prefWidth="150.0" />
                  <Button fx:id="searchButton" mnemonicParsing="false" onAction="#onSearch" text="بحث" />
                  <Button fx:id="resetButton" mnemonicParsing="false" onAction="#onReset" text="إعادة ضبط" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
            <TableView fx:id="inventoryTable" nodeOrientation="RIGHT_TO_LEFT">
               <columns>
                  <TableColumn fx:id="codeColumn" prefWidth="80.0" text="الكود" />
                  <TableColumn fx:id="nameColumn" prefWidth="150.0" text="اسم الصنف" />
                  <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="التصنيف" />
                  <TableColumn fx:id="quantityColumn" prefWidth="80.0" text="الكمية" />
                  <TableColumn fx:id="unitColumn" prefWidth="80.0" text="الوحدة" />
                  <TableColumn fx:id="purchasePriceColumn" prefWidth="100.0" text="سعر الشراء" />
                  <TableColumn fx:id="sellingPriceColumn" prefWidth="100.0" text="سعر البيع" />
                  <TableColumn fx:id="totalValueColumn" prefWidth="120.0" text="القيمة الإجمالية" />
               </columns>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </TableView>
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="20.0">
               <children>
                  <Label text="عدد الأصناف:">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="itemCountLabel" text="0">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label text="إجمالي القيمة:">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="totalValueLabel" text="0.0">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="printButton" mnemonicParsing="false" onAction="#onPrint" text="طباعة" />
                  <Button fx:id="exportButton" mnemonicParsing="false" onAction="#onExport" text="تصدير إلى Excel" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
