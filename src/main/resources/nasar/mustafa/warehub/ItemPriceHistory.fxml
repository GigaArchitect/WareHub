<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nasar.mustafa.warehub.controllers.ItemPriceHistoryController">
   <left>
      <Pane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="400.0" prefWidth="150.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="collect" layoutX="28.0" layoutY="46.0" mnemonicParsing="false" onAction="#onItemSelect" prefHeight="27.0" prefWidth="95.0" text="تجميع" />
            <Button fx:id="print" layoutX="28.0" layoutY="107.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="95.0" text="طباعة" />
         </children>
      </Pane>
   </left>
   <center>
      <TableView fx:id="tablePriceHistory" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" nodeOrientation="RIGHT_TO_LEFT" prefHeight="400.0" prefWidth="617.0" stylesheets="@style.css" BorderPane.alignment="TOP_RIGHT">
        <columns>
          <TableColumn fx:id="idColumn" prefWidth="148.0" text="مسلسل" />
            <TableColumn fx:id="priceTypeColumn" prefWidth="211.0" text="نوع السعر" />
            <TableColumn fx:id="priceColumn" prefWidth="117.0" text="السعر" />
            <TableColumn fx:id="dateColumn" prefWidth="264.0" text="التاريخ" />
        </columns>
      </TableView>
   </center>
   <top>
      <Pane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="64.0" prefWidth="955.0" BorderPane.alignment="CENTER">
         <children>
            <ComboBox fx:id="itemsCombo" layoutX="390.0" layoutY="18.0" nodeOrientation="RIGHT_TO_LEFT" prefHeight="26.0" prefWidth="437.0" />
            <Label contentDisplay="RIGHT" layoutX="847.0" layoutY="17.0" nodeOrientation="RIGHT_TO_LEFT" prefHeight="38.0" prefWidth="84.0" stylesheets="@style.css" text="أختر الصنف" textAlignment="RIGHT" />
         </children>
      </Pane>
   </top>
</BorderPane>
