<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.SearchableComboBox?>

<?import org.controlsfx.control.SearchableComboBox?>
<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="663.0" prefWidth="913.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nasar.mustafa.warehub.controllers.PurchaseOperationController">
   <center>
      <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="560.0" prefWidth="913.0" spacing="10.0">
         <children>
            <Label alignment="CENTER" text="عملية شراء جديدة" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" spacing="10.0">
               <children>
                  <Label nodeOrientation="RIGHT_TO_LEFT" text="المورد" />
                  <SearchableComboBox fx:id="supplierComboBox" prefWidth="200.0" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
            <HBox alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" spacing="10.0" style="-fx-spacing: 25;">
               <children>
                  <Label nodeOrientation="RIGHT_TO_LEFT" text="الصنف" textAlignment="CENTER" />
                  <SearchableComboBox fx:id="itemComboBox" prefWidth="200.0" />
                  <Label text="الكمية" />
                  <TextField fx:id="quantityField" prefWidth="100.0" />
                  <Button fx:id="addItemButton" mnemonicParsing="false" onAction="#onAddItemToPurchase" text="إضافة" />
                  <Button onAction="#onDeleteItem" mnemonicParsing="false" text="حذف عنصر" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
            <TableView fx:id="purchaseItemsTable" nodeOrientation="RIGHT_TO_LEFT" prefHeight="417.0" prefWidth="893.0">
               <columns>
                  <TableColumn fx:id="itemNameColumn" prefWidth="127.0" text="الصنف" />
                  <TableColumn fx:id="quantityColumn" prefWidth="123.0" text="الكمية" />
                  <TableColumn fx:id="priceColumn" prefWidth="100.0" text="السعر" />
                  <TableColumn fx:id="totalColumn" prefWidth="120.0" text="الإجمالي" />
               </columns>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </TableView>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <Pane prefHeight="79.0" prefWidth="913.0" BorderPane.alignment="CENTER">
         <children>
            <Label layoutX="845.0" layoutY="25.0" text="الإجمالى" />
            <Button fx:id="saveButton" layoutX="87.0" layoutY="21.0" mnemonicParsing="false" onAction="#onSavePurchase" text="حفظ الفاتورة" />
            <TextField fx:id="totalAmountField" layoutX="616.0" layoutY="19.0" />
         </children>
      </Pane>
   </bottom>
</BorderPane>
